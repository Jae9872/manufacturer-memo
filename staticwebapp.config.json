{
  "routes": [
    {
      "route": "/api/*",
      "methods": ["POST"],
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/*",
      "serve": "/index.html",
      "statusCode": 200
    }
  ],
  "platform": {
    "apiRuntime": "node:20"
  },
  "globalHeaders": {
    "Cache-Control": "no-cache"
  }
}